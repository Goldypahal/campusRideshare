# Application Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# Database Configuration (PostgreSQL / Neon Database)
# Example: postgresql://username:password@localhost:5432/campusrideshare
DATABASE_URL=

# External Ride-Hailing Fallback Configuration (Uber, Ola, Rapido)
EXTERNAL_RIDES_ENABLED=true
EXTERNAL_RIDES_UBER_ENABLED=true
EXTERNAL_RIDES_OLA_ENABLED=false
EXTERNAL_RIDES_RAPIDO_ENABLED=false
# Uber Developer Client ID (required for Uber universal links; obtain from developer.uber.com)
UBER_CLIENT_ID=
# Match score threshold below which external rides fallback is recommended (0-100)
EXTERNAL_RIDES_MATCH_THRESHOLD=60
# Departure time window (minutes) within which fallback is recommended for urgent departures
EXTERNAL_RIDES_SOON_MINUTES=45
